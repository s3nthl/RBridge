# RBridge Backend — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# Server
API_PORT=8000
# Comma-separated CORS origins; the first is used for links
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=sqlite+aiosqlite:///./rbridge_dev.db

# JWT (transaction links)
RBRIDGE_JWT_SECRET=change-me-to-a-32-plus-char-random-string
RBRIDGE_JWT_ALGORITHM=HS256
RBRIDGE_JWT_TTL_HOURS=72

# Resend (loan officer email)
RESEND_API_KEY=

# OpenRouter (results chat — explanation only, never in the calc path)
OPENROUTER_API_KEY=

# Feature flags
DISABLE_NON_ESSENTIAL_MODEL_CALLS=1
