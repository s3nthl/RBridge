# RBridge frontend — copy to .env.local. Never commit .env.local.

# Backend base URL, used server-side by the API proxy and server components
BACKEND_URL=http://localhost:8000

# Property lookup (server-side only). https://api.developer.attomdata.com
ATTOM_API_KEY=

# Map tiles (public token). https://mapbox.com → Account → Access tokens
NEXT_PUBLIC_MAPBOX_TOKEN=
